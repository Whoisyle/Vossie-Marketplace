# Jev / TypeSafe AI API Key
# Set this in your local environment or session: $env:JEV_API_KEY="your-key-here"
JEV_API_KEY=

# Supabase Configuration
# Obtain from your Supabase project dashboard (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Edge Function secrets are set in Supabase (supabase secrets set ...), never here and never in the app:
#   PAYMENT_PROVIDER, PAYMENT_WEBHOOK_SECRET_<PROVIDER>, NOTIFY_DISPATCH_SECRET, EMAIL_PROVIDER
#   ALLOW_MOCK_PAYMENTS=true only on development projects, never where real money moves.
